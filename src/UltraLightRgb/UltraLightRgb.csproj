<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>UltraLightRgb</AssemblyName>
    <RootNamespace>UltraLightRgb</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Ultra Light RGB Control</Product>
    <Copyright>Copyright (C) 2026 Blackwell Code, GPL-3.0-or-later</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Footprint: workstation GC without background GC thread, no ICU load -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- generated by tools\make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Drawing.Common" Version="[8.0.34]" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UltraLightRgb.Tests" />
  </ItemGroup>

</Project>
